{
  "appId": "com.greenwood.schoolmanagement",
  "appName": "Greenwood School Management",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#102a43",
      "showSpinner": true,
      "spinnerColor": "#16a34a"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#102a43"
    }
  }
}
